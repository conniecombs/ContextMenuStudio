<Window x:Class="ContextMenuStudio.Runner.RunWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Context Menu Studio — Command output" Width="850" Height="550" MinWidth="600" MinHeight="350" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <DockPanel Margin="22">
  <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Target" TextWrapping="Wrap" Foreground="#56657B" Margin="0,6,0,16"/></StackPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CancelButton" Content="Cancel" Click="CancelClick"/><Button x:Name="CloseButton" Content="Close" Click="CloseClick" IsEnabled="False"/></StackPanel><TextBlock x:Name="Status" Text="Preparing…" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
  <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" Background="#101B2C" Foreground="#E1E9F6" Padding="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Command output"/>
 </DockPanel>
</Window>