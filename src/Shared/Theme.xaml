<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#F4F6FA"/><Setter Property="Foreground" Value="#182338"/></Style>
 <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CCD5E3"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#C8D2E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,18,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,12,0,5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
</ResourceDictionary>